#!/usr/bin/env python3
# chezmoi 接管的技能不再交给外部安装器更新；其余本机登记和偏好原样保留。
import json
import sys

sys.stdin.reconfigure(encoding="utf-8")
sys.stdout.reconfigure(encoding="utf-8", newline="\n")

EXCLUDED = set(json.loads(r'''{{ concat .agent_skills.managed .agent_skills.retired | toJson }}'''))


def main():
    original = sys.stdin.read()
    try:
        state = json.loads(original) if original.strip() else {"version": 3, "skills": {}}
        if not isinstance(state, dict):
            raise ValueError("根节点必须是对象")
        skills = state.get("skills", {})
        if not isinstance(skills, dict):
            raise ValueError("skills 必须是对象")
    except (ValueError, TypeError) as error:
        sys.exit(f"技能锁文件格式错误，未输出替换内容：{error}")

    retained = {name: record for name, record in skills.items() if name not in EXCLUDED}
    if retained == skills and original.strip():
        # 没有迁移项时连原来的缩进和换行也保持不变。
        sys.stdout.write(original)
        return
    state["skills"] = retained
    json.dump(state, sys.stdout, ensure_ascii=False, indent=2)
    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
