{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -e

# ==================== 通用工具 ====================
BIN_DIR="$HOME/.local/bin"

# 代理宿主机探测复用 cc-proxy-host（chezmoi 按目标名序先落 dotfiles 再跑本脚本）
proxy_host() {
    if [[ -x "$HOME/.custom_scripts/cc-proxy-host" ]]; then
        "$HOME/.custom_scripts/cc-proxy-host"
    else
        echo "127.0.0.1"
    fi
}

# GitHub release 静态二进制兜底（cargo / 官方 apt 源不可用时的最后一道）
install_github_release() {
    local tool="$1"
    local arch suffix url tmp ok=1

    if [[ -x "$BIN_DIR/$tool" ]] || command -v "$tool" &>/dev/null; then
        echo "[SKIP] $tool already installed"
        return 0
    fi

    case "$(uname -m)" in
        x86_64)  arch="x86_64" ;;
        aarch64) arch="aarch64" ;;
        *)
            echo "[FAIL] $tool: 不支持的架构 $(uname -m)"
            return 1
            ;;
    esac

    case "$tool" in
        eza|yazi) ;;
        *)
            echo "[FAIL] $tool: 无兜底安装器"
            return 1
            ;;
    esac

    tmp="$(mktemp -d)"
    case "$tool" in
        eza)
            # eza 未发布 aarch64 musl 产物，该架构退回 gnu 版
            if [[ "$arch" == "aarch64" ]]; then
                suffix="gnu"
            else
                suffix="musl"
            fi
            url="https://github.com/eza-community/eza/releases/latest/download/eza_${arch}-unknown-linux-${suffix}.tar.gz"
            echo "[INSTALL] eza <- ${url##*/}"
            if curl -fL --retry 3 --connect-timeout 15 -o "$tmp/eza.tar.gz" "$url" \
                && tar -xzf "$tmp/eza.tar.gz" -C "$tmp" \
                && install -Dm755 "$tmp/eza" "$BIN_DIR/eza"; then
                ok=0
            fi
            ;;
        yazi)
            url="https://github.com/sxyazi/yazi/releases/latest/download/yazi-${arch}-unknown-linux-musl.zip"
            echo "[INSTALL] yazi <- ${url##*/}"
            if curl -fL --retry 3 --connect-timeout 15 -o "$tmp/yazi.zip" "$url" \
                && unzip -qo "$tmp/yazi.zip" -d "$tmp" \
                && install -Dm755 "$tmp"/yazi-*/yazi "$BIN_DIR/yazi" \
                && install -Dm755 "$tmp"/yazi-*/ya "$BIN_DIR/ya"; then
                ok=0
            fi
            ;;
    esac
    rm -rf "$tmp"

    if [[ $ok -eq 0 && -x "$BIN_DIR/$tool" ]]; then
        echo "[OK] $tool -> $BIN_DIR/$tool"
        return 0
    fi
    echo "[FAIL] $tool: 下载或安装失败（GitHub 直连不通时请在 proxychains 环境下重跑 chezmoi apply）"
    return 1
}

# ==================== Rust 工具链（官方 rustup，nightly） ====================
install_rust_nightly() {
    local proxy
    proxy="http://$(proxy_host):10808"

    # 已装 rustup 但当前进程 PATH 未包含 ~/.cargo/bin 时先加载
    if ! command -v rustup &>/dev/null && [[ -f "$HOME/.cargo/env" ]]; then
        source "$HOME/.cargo/env"
    fi

    if command -v rustup &>/dev/null; then
        if rustup toolchain list 2>/dev/null | grep -q '^nightly'; then
            echo "[SKIP] rust nightly already installed"
        else
            echo "[INSTALL] rust nightly toolchain..."
            HTTPS_PROXY="$proxy" HTTP_PROXY="$proxy" rustup toolchain install nightly \
                || rustup toolchain install nightly \
                || { echo "[FAIL] rust nightly toolchain 安装失败"; return 1; }
        fi
        return 0
    fi

    echo "[INSTALL] rustup <- 官方脚本 sh.rustup.rs（default=nightly）..."
    # 官方安装方式；整条管道包代理（curl 与 rustup-init 都要联网），失败退回直连
    if env HTTPS_PROXY="$proxy" HTTP_PROXY="$proxy" bash -c \
            'curl --proto "=https" --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path --default-toolchain nightly' \
        || bash -c 'curl --proto "=https" --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path --default-toolchain nightly'; then
        source "$HOME/.cargo/env"
        echo "[OK] $(rustc --version)"
        return 0
    fi
    echo "[FAIL] rustup 安装失败"
    return 1
}

# ==================== eza（cargo 安装，无 cargo 时退回二进制） ====================
install_eza() {
    if [[ -x "$BIN_DIR/eza" ]] || command -v eza &>/dev/null; then
        echo "[SKIP] eza already installed"
        return 0
    fi
    if command -v cargo &>/dev/null; then
        echo "[INSTALL] eza <- cargo install"
        # WSL 的 ~/.cargo/config.toml 已按环境裁掉 proxy 行，这里按当前网关显式补上；
        # 非 WSL 机器该值与配置文件一致，属无害覆盖
        if CARGO_HTTP_PROXY="http://$(proxy_host):10808" cargo install eza; then
            echo "[OK] eza -> $HOME/.cargo/bin/eza"
            return 0
        fi
        echo "[WARN] cargo install eza 失败，退回 GitHub release 二进制"
    else
        echo "[WARN] 未安装 cargo，eza 退回 GitHub release 二进制"
    fi
    install_github_release eza
}

# ==================== yazi（官方 apt 源 nightly，失败退回二进制） ====================
install_yazi() {
    if command -v yazi &>/dev/null || [[ -x "$BIN_DIR/yazi" ]]; then
        echo "[SKIP] yazi already installed"
        return 0
    fi

    local proxy keyring list tmp
    proxy="http://$(proxy_host):10808"
    keyring="/usr/share/keyrings/yazi-keyring.gpg"
    list="/etc/apt/sources.list.d/yazi-nightly.list"
    echo "[INSTALL] yazi <- 官方 apt 源（nightly）"

    # 仓库托管在 GitHub Pages，直连不稳：curl 先走代理、失败退回直连；
    # 先落临时文件并校验非空，避免管道失败时给 keyring 写出空文件
    tmp="$(mktemp)"
    if ! curl -fsSL --proxy "$proxy" --max-time 30 https://yazi-rs.github.io/builds/yazi-keyring.gpg -o "$tmp" \
        && ! curl -fsSL --max-time 30 https://yazi-rs.github.io/builds/yazi-keyring.gpg -o "$tmp"; then
        rm -f "$tmp"
        echo "[WARN] yazi: keyring 下载失败，退回 GitHub release 二进制"
        install_github_release yazi
        return
    fi
    if [[ ! -s "$tmp" ]]; then
        rm -f "$tmp"
        echo "[WARN] yazi: keyring 为空，退回 GitHub release 二进制"
        install_github_release yazi
        return
    fi
    sudo install -Dm644 "$tmp" "$keyring"
    rm -f "$tmp"

    echo "deb [signed-by=$keyring] https://yazi-rs.github.io/builds/ nightly main" | sudo tee "$list" >/dev/null

    # sudo 会剥离代理环境，apt 对该仓库域名单独挂代理；代理不可用时退回直连再试
    if { sudo apt -o "Acquire::https::Proxy::yazi-rs.github.io=$proxy" update \
            && sudo apt -o "Acquire::https::Proxy::yazi-rs.github.io=$proxy" install -y -t nightly yazi; } \
        || { sudo apt update && sudo apt install -y -t nightly yazi; }; then
        echo "[OK] yazi -> $(command -v yazi)"
        return 0
    fi
    echo "[WARN] yazi: apt 源安装失败，退回 GitHub release 二进制"
    install_github_release yazi
}

# ==================== 基础包 ====================
if command -v apt &>/dev/null; then
    # 仅放确定在 apt 源内的包；eza/yazi/rust 走下方专用安装段
    PACKAGES=(
        zoxide
        zsh
        fzf
        ripgrep
        btop
        jq
        wget
        curl
        unzip
        connect-proxy
        proxychains4
        software-properties-common
    )

    MISSING=()
    for pkg in "${PACKAGES[@]}"; do
        if ! dpkg -s "$pkg" &>/dev/null; then
            MISSING+=("$pkg")
        fi
    done

    FAILED=()

    if [[ ${#MISSING[@]} -gt 0 ]]; then
        APT_UPDATED=0
        # 全新机器 apt 元数据为空时 apt-cache 查不到任何包，先刷新一次
        if ! ls /var/lib/apt/lists/*Packages* &>/dev/null; then
            sudo apt update -y
            APT_UPDATED=1
        fi

        # 防御：源里不存在的包单独剔出，避免 apt "一个找不到、整单作废"
        APT_PKGS=()
        UNKNOWN_PKGS=()
        for pkg in "${MISSING[@]}"; do
            if apt-cache show "$pkg" &>/dev/null; then
                APT_PKGS+=("$pkg")
            else
                UNKNOWN_PKGS+=("$pkg")
            fi
        done

        if [[ ${#APT_PKGS[@]} -gt 0 ]]; then
            echo "[INSTALL] apt: ${APT_PKGS[*]}"
            if [[ $APT_UPDATED -eq 0 ]]; then
                sudo apt update -y
            fi
            sudo apt install -y "${APT_PKGS[@]}"
        fi

        for pkg in "${UNKNOWN_PKGS[@]}"; do
            echo "[WARN] $pkg: apt 源中不存在"
            FAILED+=("$pkg")
        done
    else
        echo "[SKIP] All apt packages already installed"
    fi

    # 源外组件：rust 官方脚本、eza 走 cargo、yazi 走官方 apt 源
    install_rust_nightly || FAILED+=("rust-nightly")
    install_eza || FAILED+=("eza")
    install_yazi || FAILED+=("yazi")

    if [[ ${#FAILED[@]} -gt 0 ]]; then
        echo "[FAIL] 以下组件安装失败: ${FAILED[*]}"
        exit 1
    fi

    # Neovim nightly（unstable PPA）
    if command -v nvim &>/dev/null && nvim --version 2>/dev/null | head -1 | grep -q 'dev'; then
        echo "[SKIP] neovim (nightly) already installed"
    else
        echo "[INSTALL] neovim (unstable PPA)..."
        sudo add-apt-repository -y ppa:neovim-ppa/unstable
        sudo apt update -y
        sudo apt install -y neovim
    fi

elif command -v pacman &>/dev/null; then
    # Arch 官方仓库版本足够新，eza/yazi 直接走 pacman；rust 仍用官方 rustup
    PACKAGES=(
        zoxide
        zsh
        eza
        fzf
        yazi
        ripgrep
        btop
        jq
        wget
        connect-proxy
        proxychains-ng
    )

    MISSING=()
    for pkg in "${PACKAGES[@]}"; do
        if ! pacman -Qi "$pkg" &>/dev/null; then
            MISSING+=("$pkg")
        fi
    done

    if [[ ${#MISSING[@]} -gt 0 ]]; then
        echo "[INSTALL] ${MISSING[*]}"
        sudo pacman -S --noconfirm "${MISSING[@]}"
    else
        echo "[SKIP] All packages already installed"
    fi

    install_rust_nightly

    # Neovim nightly（neovim-nightly-bin from AUR）
    if command -v nvim &>/dev/null && nvim --version 2>/dev/null | head -1 | grep -q 'dev'; then
        echo "[SKIP] neovim (nightly) already installed"
    else
        echo "[INSTALL] neovim-nightly-bin (AUR)..."
        if command -v yay &>/dev/null; then
            yay -S --noconfirm neovim-nightly-bin
        elif command -v paru &>/dev/null; then
            paru -S --noconfirm neovim-nightly-bin
        else
            echo "[WARN] 需要 yay 或 paru 安装 AUR 包"
        fi
    fi
fi

# vim/vi/editor 统一指向 nvim（系统级：覆盖 sudo/脚本/git 等不走 shell 别名的场景）
if command -v nvim &>/dev/null; then
    NVIM_BIN="$(command -v nvim)"
    if command -v update-alternatives &>/dev/null; then
        # Debian/Ubuntu 系：alternatives 机制，优先级 100 > nano(40) > vim.tiny(15)
        for name in vim vi editor; do
            CURRENT="$(update-alternatives --query "$name" 2>/dev/null | awk '/^Value:/{print $2}')"
            if [[ "$CURRENT" == "$NVIM_BIN" ]]; then
                echo "[SKIP] alternatives: $name -> $NVIM_BIN"
            else
                echo "[OK] alternatives: $name -> $NVIM_BIN"
                sudo update-alternatives --install "/usr/bin/$name" "$name" "$NVIM_BIN" 100
            fi
        done
    else
        # 无 update-alternatives（如 Arch）：/usr/local/bin 符号链接兜底（PATH 优先于 /usr/bin）
        # editor 是 Debian 特有约定，此处只处理 vim/vi
        for name in vim vi; do
            if [[ "$(readlink -f "/usr/local/bin/$name" 2>/dev/null)" == "$(readlink -f "$NVIM_BIN")" ]]; then
                echo "[SKIP] symlink: /usr/local/bin/$name -> $NVIM_BIN"
            else
                echo "[OK] symlink: /usr/local/bin/$name -> $NVIM_BIN"
                sudo ln -sfn "$NVIM_BIN" "/usr/local/bin/$name"
            fi
        done
    fi
else
    echo "[WARN] 未检测到 nvim，跳过 vim/vi/editor 重定向"
fi

# Oh My Zsh
if [[ -d "$HOME/.oh-my-zsh" ]]; then
    echo "[SKIP] Oh My Zsh already installed"
else
    echo "[INSTALL] Oh My Zsh..."
    RUNZSH=no KEEP_ZSHRC=yes sh -c "$(curl -fsSL https://raw.github.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
fi

# Zsh 插件（oh-my-zsh custom plugins）
ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"
declare -A ZSH_PLUGINS=(
    [zsh-syntax-highlighting]="https://github.com/zsh-users/zsh-syntax-highlighting"
    [zsh-autosuggestions]="https://github.com/zsh-users/zsh-autosuggestions"
    [zsh-completions]="https://github.com/zsh-users/zsh-completions"
)

for plugin in "${!ZSH_PLUGINS[@]}"; do
    if [[ -d "$ZSH_CUSTOM/plugins/$plugin" ]]; then
        echo "[SKIP] $plugin already installed"
    else
        echo "[INSTALL] $plugin..."
        git clone "${ZSH_PLUGINS[$plugin]}" "$ZSH_CUSTOM/plugins/$plugin"
    fi
done

# chezmoi auto commit/push
mkdir -p ~/.config/chezmoi
if ! grep -q "autoCommit" ~/.config/chezmoi/chezmoi.toml 2>/dev/null; then
    cat >> ~/.config/chezmoi/chezmoi.toml << 'EOF'
[git]
    autoCommit = true
    autoPush = true
EOF
    echo "[OK] chezmoi auto commit/push enabled"
else
    echo "[SKIP] chezmoi already configured"
fi

echo "[DONE] Linux setup complete"
{{ end -}}
