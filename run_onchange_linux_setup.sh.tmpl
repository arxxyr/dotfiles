{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -e

# ==================== 通用工具 ====================
BIN_DIR="$HOME/.local/bin"

# 代理宿主机探测复用 cc-proxy-host（chezmoi 按目标名序先落 dotfiles 再跑本脚本）
proxy_host() {
    if [[ -x "$HOME/.custom_scripts/cc-proxy-host" ]]; then
        "$HOME/.custom_scripts/cc-proxy-host"
    else
        echo "127.0.0.1"
    fi
}

# 全程走代理：尊重外部已注入的代理（proxychains/手动 export 可覆盖），否则回落网关；
# 补齐未显式带 --proxy 的下载（如 GitHub release）；apt/pacman 经 sudo 隔离仍走系统源
_default_proxy="http://$(proxy_host):{{ .proxy.port }}"
export ALL_PROXY="${ALL_PROXY:-$_default_proxy}"
export HTTPS_PROXY="${HTTPS_PROXY:-$ALL_PROXY}"
export HTTP_PROXY="${HTTP_PROXY:-$ALL_PROXY}"
export NO_PROXY="${NO_PROXY:-localhost,127.0.0.1,::1}"

# GitHub release 静态二进制兜底（cargo / 官方 apt 源不可用时的最后一道）
install_github_release() {
    local tool="$1"
    local arch suffix url tmp ok=1

    if [[ -x "$BIN_DIR/$tool" ]] || command -v "$tool" &>/dev/null; then
        echo "[SKIP] $tool already installed"
        return 0
    fi

    case "$(uname -m)" in
        x86_64)  arch="x86_64" ;;
        aarch64) arch="aarch64" ;;
        *)
            echo "[FAIL] $tool: 不支持的架构 $(uname -m)"
            return 1
            ;;
    esac

    case "$tool" in
        eza|yazi) ;;
        *)
            echo "[FAIL] $tool: 无兜底安装器"
            return 1
            ;;
    esac

    tmp="$(mktemp -d)"
    case "$tool" in
        eza)
            # eza 未发布 aarch64 musl 产物，该架构退回 gnu 版
            if [[ "$arch" == "aarch64" ]]; then
                suffix="gnu"
            else
                suffix="musl"
            fi
            url="https://github.com/eza-community/eza/releases/latest/download/eza_${arch}-unknown-linux-${suffix}.tar.gz"
            echo "[INSTALL] eza <- ${url##*/}"
            if curl -fL --retry 3 --connect-timeout 15 -o "$tmp/eza.tar.gz" "$url" \
                && tar -xzf "$tmp/eza.tar.gz" -C "$tmp" \
                && install -Dm755 "$tmp/eza" "$BIN_DIR/eza"; then
                ok=0
            fi
            ;;
        yazi)
            url="https://github.com/sxyazi/yazi/releases/latest/download/yazi-${arch}-unknown-linux-musl.zip"
            echo "[INSTALL] yazi <- ${url##*/}"
            if curl -fL --retry 3 --connect-timeout 15 -o "$tmp/yazi.zip" "$url" \
                && unzip -qo "$tmp/yazi.zip" -d "$tmp" \
                && install -Dm755 "$tmp"/yazi-*/yazi "$BIN_DIR/yazi" \
                && install -Dm755 "$tmp"/yazi-*/ya "$BIN_DIR/ya"; then
                ok=0
            fi
            ;;
    esac
    rm -rf "$tmp"

    if [[ $ok -eq 0 && -x "$BIN_DIR/$tool" ]]; then
        echo "[OK] $tool -> $BIN_DIR/$tool"
        return 0
    fi
    echo "[FAIL] $tool: 下载或安装失败（GitHub 直连不通时请在 proxychains 环境下重跑 chezmoi apply）"
    return 1
}

# ==================== Rust 工具链（官方 rustup，nightly） ====================
install_rust_nightly() {
    local proxy
    proxy="http://$(proxy_host):{{ .proxy.port }}"

    # 已装 rustup 但当前进程 PATH 未包含 ~/.cargo/bin 时先加载
    if ! command -v rustup &>/dev/null && [[ -f "$HOME/.cargo/env" ]]; then
        source "$HOME/.cargo/env"
    fi

    if command -v rustup &>/dev/null; then
        if rustup toolchain list 2>/dev/null | grep -q '^nightly'; then
            echo "[SKIP] rust nightly already installed"
        else
            echo "[INSTALL] rust nightly toolchain..."
            HTTPS_PROXY="$proxy" HTTP_PROXY="$proxy" rustup toolchain install nightly \
                || rustup toolchain install nightly \
                || { echo "[FAIL] rust nightly toolchain 安装失败"; return 1; }
        fi
        return 0
    fi

    echo "[INSTALL] rustup <- 官方脚本 sh.rustup.rs（default=nightly）..."
    # 官方安装方式；整条管道包代理（curl 与 rustup-init 都要联网），失败退回直连
    if env HTTPS_PROXY="$proxy" HTTP_PROXY="$proxy" bash -c \
            'curl --proto "=https" --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path --default-toolchain nightly' \
        || bash -c 'curl --proto "=https" --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path --default-toolchain nightly'; then
        source "$HOME/.cargo/env"
        echo "[OK] $(rustc --version)"
        return 0
    fi
    echo "[FAIL] rustup 安装失败"
    return 1
}

# ==================== eza（cargo 安装，无 cargo 时退回二进制） ====================
install_eza() {
    if [[ -x "$BIN_DIR/eza" ]] || command -v eza &>/dev/null; then
        echo "[SKIP] eza already installed"
        return 0
    fi
    if command -v cargo &>/dev/null; then
        echo "[INSTALL] eza <- cargo install"
        # WSL 的 ~/.cargo/config.toml 已按环境裁掉 proxy 行，这里按当前网关显式补上；
        # 非 WSL 机器该值与配置文件一致，属无害覆盖
        if CARGO_HTTP_PROXY="http://$(proxy_host):{{ .proxy.port }}" cargo install eza; then
            echo "[OK] eza -> $HOME/.cargo/bin/eza"
            return 0
        fi
        echo "[WARN] cargo install eza 失败，退回 GitHub release 二进制"
    else
        echo "[WARN] 未安装 cargo，eza 退回 GitHub release 二进制"
    fi
    install_github_release eza
}

# ==================== yazi（官方 apt 源 nightly，失败退回二进制） ====================
install_yazi() {
    if command -v yazi &>/dev/null || [[ -x "$BIN_DIR/yazi" ]]; then
        echo "[SKIP] yazi already installed"
        return 0
    fi

    local proxy keyring list tmp
    proxy="http://$(proxy_host):{{ .proxy.port }}"
    keyring="/usr/share/keyrings/yazi-keyring.gpg"
    list="/etc/apt/sources.list.d/yazi-nightly.list"
    echo "[INSTALL] yazi <- 官方 apt 源（nightly）"

    # 仓库托管在 GitHub Pages，直连不稳：curl 先走代理、失败退回直连；
    # 先落临时文件并校验非空，避免管道失败时给 keyring 写出空文件
    tmp="$(mktemp)"
    if ! curl -fsSL --proxy "$proxy" --max-time 30 https://yazi-rs.github.io/builds/yazi-keyring.gpg -o "$tmp" \
        && ! curl -fsSL --max-time 30 https://yazi-rs.github.io/builds/yazi-keyring.gpg -o "$tmp"; then
        rm -f "$tmp"
        echo "[WARN] yazi: keyring 下载失败，退回 GitHub release 二进制"
        install_github_release yazi
        return
    fi
    if [[ ! -s "$tmp" ]]; then
        rm -f "$tmp"
        echo "[WARN] yazi: keyring 为空，退回 GitHub release 二进制"
        install_github_release yazi
        return
    fi
    sudo install -Dm644 "$tmp" "$keyring"
    rm -f "$tmp"

    echo "deb [signed-by=$keyring] https://yazi-rs.github.io/builds/ nightly main" | sudo tee "$list" >/dev/null

    # sudo 会剥离代理环境，apt 对该仓库域名单独挂代理；代理不可用时退回直连再试
    if { sudo apt -o "Acquire::https::Proxy::yazi-rs.github.io=$proxy" update \
            && sudo apt -o "Acquire::https::Proxy::yazi-rs.github.io=$proxy" install -y -t nightly yazi; } \
        || { sudo apt update && sudo apt install -y -t nightly yazi; }; then
        echo "[OK] yazi -> $(command -v yazi)"
        return 0
    fi
    echo "[WARN] yazi: apt 源安装失败，退回 GitHub release 二进制"
    install_github_release yazi
}

# ==================== uv（官方安装脚本 astral.sh） ====================
install_uv() {
    if command -v uv &>/dev/null || [[ -x "$BIN_DIR/uv" ]]; then
        echo "[SKIP] uv already installed"
        return 0
    fi

    local proxy
    proxy="http://$(proxy_host):{{ .proxy.port }}"

    echo "[INSTALL] uv <- 官方脚本 astral.sh/uv/install.sh..."
    # 官方安装方式，默认落 ~/.local/bin；整条管道包代理（curl 与安装器内部
    # 下载 release 产物都要联网），失败退回直连。UV_NO_MODIFY_PATH=1 禁写
    # 纳管 rc（PATH 引导由 profile.sh source ~/.local/bin/env 承担），
    # uv self update 也遵守该标记不回写
    if env HTTPS_PROXY="$proxy" HTTP_PROXY="$proxy" UV_NO_MODIFY_PATH=1 bash -c \
            'set -o pipefail; curl -LsSf https://astral.sh/uv/install.sh | sh' \
        || env UV_NO_MODIFY_PATH=1 bash -c \
            'set -o pipefail; curl -LsSf https://astral.sh/uv/install.sh | sh'; then
        if [[ -x "$BIN_DIR/uv" ]] || command -v uv &>/dev/null; then
            echo "[OK] $("$BIN_DIR/uv" --version 2>/dev/null || uv --version)"
            return 0
        fi
    fi
    echo "[FAIL] uv 安装失败"
    return 1
}

# ==================== Node.js（官方 nvm 脚本，LTS） ====================
# nvm 加载器已在纳管 rc 模板（zshrc/bashrc）中，此处只负责安装；
# PROFILE=/dev/null 禁写 rc，与 rustup --no-modify-path / UV_NO_MODIFY_PATH 同一纪律
NVM_VERSION="v0.40.3"
install_node() {
    export NVM_DIR="$HOME/.nvm"
    local proxy
    proxy="http://$(proxy_host):{{ .proxy.port }}"

    if [[ -s "$NVM_DIR/nvm.sh" ]]; then
        echo "[SKIP] nvm already installed"
    else
        echo "[INSTALL] nvm <- 官方脚本 ${NVM_VERSION}..."
        env HTTPS_PROXY="$proxy" HTTP_PROXY="$proxy" PROFILE=/dev/null bash -c \
                "set -o pipefail; curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/${NVM_VERSION}/install.sh | bash" \
            || env PROFILE=/dev/null bash -c \
                "set -o pipefail; curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/${NVM_VERSION}/install.sh | bash" \
            || { echo "[FAIL] nvm 安装失败"; return 1; }
    fi

    # nvm.sh 在无默认别名等场景可能返回非零（脚本全局 set -e），容错后再验证
    source "$NVM_DIR/nvm.sh" 2>/dev/null || true
    command -v nvm &>/dev/null || { echo "[FAIL] nvm 加载失败"; return 1; }

    if command -v node &>/dev/null; then
        echo "[SKIP] node already installed ($(node --version))"
        return 0
    fi
    echo "[INSTALL] node LTS <- nvm install --lts..."
    HTTPS_PROXY="$proxy" HTTP_PROXY="$proxy" nvm install --lts \
        || nvm install --lts \
        || { echo "[FAIL] node 安装失败"; return 1; }
    echo "[OK] node $(node --version) / npm $(npm --version)"
}

# ==================== Codex CLI（npm 全局） ====================
install_codex() {
    if command -v codex &>/dev/null; then
        echo "[SKIP] codex already installed"
        return 0
    fi
    if ! command -v npm &>/dev/null; then
        echo "[FAIL] codex: npm 不可用（node 未装成功）"
        return 1
    fi
    local proxy
    proxy="http://$(proxy_host):{{ .proxy.port }}"
    echo "[INSTALL] codex <- npm install -g @openai/codex..."
    HTTPS_PROXY="$proxy" HTTP_PROXY="$proxy" npm install -g @openai/codex \
        || npm install -g @openai/codex \
        || { echo "[FAIL] codex 安装失败"; return 1; }
    echo "[OK] codex $(codex --version 2>/dev/null | head -1)"
}

# ==================== Claude Code（官方原生安装器） ====================
install_claude_code() {
    if command -v claude &>/dev/null || [[ -x "$HOME/.local/bin/claude" ]]; then
        echo "[SKIP] claude code already installed"
        return 0
    fi
    local proxy
    proxy="http://$(proxy_host):{{ .proxy.port }}"
    echo "[INSTALL] claude code <- 官方脚本 claude.ai/install.sh..."
    # 安装器是静态二进制，proxychains 的 LD_PRELOAD 对它无效，必须 env 代理；
    # ~/.claude/settings.json 模板在 WSL 渲染不含代理键，不会盖掉此处 env
    env HTTPS_PROXY="$proxy" HTTP_PROXY="$proxy" bash -c \
            'set -o pipefail; curl -fsSL https://claude.ai/install.sh | bash' \
        || bash -c 'set -o pipefail; curl -fsSL https://claude.ai/install.sh | bash' \
        || { echo "[FAIL] claude code 安装失败"; return 1; }
    echo "[OK] claude -> $HOME/.local/bin/claude"
}

# ==================== WezTerm（Linux 桌面；WSL 跳过） ====================
install_wezterm() {
    # WSL 的终端由 Windows 侧承担（Windows Terminal），Linux 版 WezTerm 无用武之地
    if [[ -n "${WSL_DISTRO_NAME:-}" ]] || grep -qi microsoft /proc/version 2>/dev/null; then
        echo "[SKIP] wezterm: WSL 环境（终端由 Windows 侧提供）"
        return 0
    fi
    if command -v wezterm &>/dev/null; then
        echo "[SKIP] wezterm already installed"
    elif command -v apt &>/dev/null; then
        local proxy keyring list tmp
        proxy="http://$(proxy_host):{{ .proxy.port }}"
        keyring="/usr/share/keyrings/wezterm-fury.gpg"
        list="/etc/apt/sources.list.d/wezterm.list"
        echo "[INSTALL] wezterm <- 官方 fury 源（nightly）"

        # fury CDN 直连不稳：key 先代理后直连；落临时文件校验非空再 dearmor
        tmp="$(mktemp)"
        if ! curl -fsSL --proxy "$proxy" --max-time 30 https://apt.fury.io/wez/gpg.key -o "$tmp" \
            && ! curl -fsSL --max-time 30 https://apt.fury.io/wez/gpg.key -o "$tmp"; then
            rm -f "$tmp"
            echo "[FAIL] wezterm: gpg key 下载失败"
            return 1
        fi
        if [[ ! -s "$tmp" ]]; then
            rm -f "$tmp"
            echo "[FAIL] wezterm: gpg key 为空"
            return 1
        fi
        sudo gpg --yes --dearmor -o "$keyring" "$tmp"
        rm -f "$tmp"
        sudo chmod 644 "$keyring"
        echo "deb [signed-by=$keyring] https://apt.fury.io/wez/ * *" | sudo tee "$list" >/dev/null

        # sudo 剥离代理环境，对该仓库域名单独挂代理；失败退回直连
        { sudo apt -o "Acquire::https::Proxy::apt.fury.io=$proxy" update \
            && sudo apt -o "Acquire::https::Proxy::apt.fury.io=$proxy" install -y wezterm-nightly; } \
            || { sudo apt update && sudo apt install -y wezterm-nightly; } \
            || { echo "[FAIL] wezterm 安装失败"; return 1; }
    elif command -v pacman &>/dev/null; then
        echo "[INSTALL] wezterm <- pacman"
        sudo pacman -S --noconfirm --needed wezterm || { echo "[FAIL] wezterm 安装失败"; return 1; }
    fi

    # 默认终端指向 wezterm（Debian 系 alternatives；--set 非交互，替代原手动 --config）
    if command -v update-alternatives &>/dev/null; then
        local alt
        alt="$(update-alternatives --list x-terminal-emulator 2>/dev/null | grep -i wezterm | head -1)"
        if [[ -n "$alt" ]]; then
            sudo update-alternatives --set x-terminal-emulator "$alt"
            echo "[OK] x-terminal-emulator -> $alt"
        fi
    fi
    return 0
}

# ==================== AUR helper（yay-bin，仅 Arch） ====================
install_aur_helper() {
    if command -v yay &>/dev/null || command -v paru &>/dev/null; then
        echo "[SKIP] AUR helper already installed"
        return 0
    fi
    local proxy tmp
    proxy="http://$(proxy_host):{{ .proxy.port }}"
    tmp="$(mktemp -d)"
    echo "[INSTALL] yay-bin <- AUR（makepkg）..."
    # yay-bin 为预编译 release 包，makepkg 无需 go 工具链；makepkg 禁 root，
    # 依赖 base-devel（已入基础包列表）
    if ! env HTTPS_PROXY="$proxy" HTTP_PROXY="$proxy" git clone --depth 1 https://aur.archlinux.org/yay-bin.git "$tmp/yay-bin" \
        && ! git clone --depth 1 https://aur.archlinux.org/yay-bin.git "$tmp/yay-bin"; then
        rm -rf "$tmp"
        echo "[FAIL] yay-bin: AUR clone 失败"
        return 1
    fi
    if ! ( cd "$tmp/yay-bin" && env HTTPS_PROXY="$proxy" HTTP_PROXY="$proxy" makepkg -si --noconfirm ); then
        rm -rf "$tmp"
        echo "[FAIL] yay-bin 安装失败"
        return 1
    fi
    rm -rf "$tmp"
    echo "[OK] $(yay --version 2>/dev/null | head -1)"
}

# ==================== 基础包 ====================
if command -v apt &>/dev/null; then
    # 强制 apt 走 IPv4（IPv6 路由不稳时 update 挂起的老毛病）
    if [[ -f /etc/apt/apt.conf.d/99force-ipv4 ]]; then
        echo "[SKIP] apt force-ipv4 already configured"
    else
        echo 'Acquire::ForceIPv4 "true";' | sudo tee /etc/apt/apt.conf.d/99force-ipv4 >/dev/null
        echo "[OK] apt force-ipv4 configured"
    fi

    # 仅放确定在 apt 源内的包；eza/yazi/rust/uv/node/claude/codex 走下方专用安装段。
    # netcat-openbsd 提供 nc -X：cc-proxy SSH 打洞在 Linux 的兜底（connect 仅 mac 保留）
    PACKAGES=(
        zoxide
        zsh
        fzf
        ripgrep
        btop
        jq
        git
        wget
        curl
        unzip
        build-essential
        netcat-openbsd
        proxychains4
        software-properties-common
    )

    MISSING=()
    for pkg in "${PACKAGES[@]}"; do
        if ! dpkg -s "$pkg" &>/dev/null; then
            MISSING+=("$pkg")
        fi
    done

    FAILED=()

    if [[ ${#MISSING[@]} -gt 0 ]]; then
        APT_UPDATED=0
        # 全新机器 apt 元数据为空时 apt-cache 查不到任何包，先刷新一次
        if ! ls /var/lib/apt/lists/*Packages* &>/dev/null; then
            sudo apt update -y
            APT_UPDATED=1
        fi

        # 防御：源里不存在的包单独剔出，避免 apt "一个找不到、整单作废"
        APT_PKGS=()
        UNKNOWN_PKGS=()
        for pkg in "${MISSING[@]}"; do
            if apt-cache show "$pkg" &>/dev/null; then
                APT_PKGS+=("$pkg")
            else
                UNKNOWN_PKGS+=("$pkg")
            fi
        done

        if [[ ${#APT_PKGS[@]} -gt 0 ]]; then
            echo "[INSTALL] apt: ${APT_PKGS[*]}"
            if [[ $APT_UPDATED -eq 0 ]]; then
                sudo apt update -y
            fi
            sudo apt install -y "${APT_PKGS[@]}"
        fi

        for pkg in "${UNKNOWN_PKGS[@]}"; do
            echo "[WARN] $pkg: apt 源中不存在"
            FAILED+=("$pkg")
        done
    else
        echo "[SKIP] All apt packages already installed"
    fi

    # 源外组件：rust/uv/nvm/claude 官方脚本、eza 走 cargo、yazi 走官方 apt 源、codex 走 npm
    install_rust_nightly || FAILED+=("rust-nightly")
    install_eza || FAILED+=("eza")
    install_yazi || FAILED+=("yazi")
    install_uv || FAILED+=("uv")
    install_node || FAILED+=("node")
    install_codex || FAILED+=("codex")
    install_claude_code || FAILED+=("claude-code")
    install_wezterm || FAILED+=("wezterm")

    if [[ ${#FAILED[@]} -gt 0 ]]; then
        echo "[FAIL] 以下组件安装失败: ${FAILED[*]}"
        exit 1
    fi

    # Neovim nightly（unstable PPA）
    if command -v nvim &>/dev/null && nvim --version 2>/dev/null | head -1 | grep -q 'dev'; then
        echo "[SKIP] neovim (nightly) already installed"
    else
        echo "[INSTALL] neovim (unstable PPA)..."
        sudo add-apt-repository -y ppa:neovim-ppa/unstable
        sudo apt update -y
        sudo apt install -y neovim
    fi

elif command -v pacman &>/dev/null; then
    # Arch 官方仓库版本足够新，eza/yazi/uv 直接走 pacman；rust 仍用官方 rustup，
    # node/claude/codex 与 apt 分支共用官方脚本安装段。
    # 最小安装无 git/curl/unzip，须显式列出（官方脚本与 omz clone 都依赖）；
    # openbsd-netcat 提供 nc -X：cc-proxy SSH 打洞兜底（connect 仅 mac 保留）
    PACKAGES=(
        zoxide
        zsh
        eza
        fzf
        yazi
        uv
        ripgrep
        btop
        jq
        git
        wget
        curl
        unzip
        base-devel
        openbsd-netcat
        proxychains-ng
    )

    MISSING=()
    for pkg in "${PACKAGES[@]}"; do
        # -Qi 只认单包；base-devel 这类包组用 -Qg 兜底（组内有成员在装即视为已装，
        # 安装时 --needed 会补齐缺失成员）
        if ! pacman -Qi "$pkg" &>/dev/null && ! pacman -Qg "$pkg" &>/dev/null; then
            MISSING+=("$pkg")
        fi
    done

    if [[ ${#MISSING[@]} -gt 0 ]]; then
        echo "[INSTALL] ${MISSING[*]}"
        sudo pacman -S --noconfirm --needed "${MISSING[@]}"
    else
        echo "[SKIP] All packages already installed"
    fi

    install_rust_nightly
    install_node
    install_codex
    install_claude_code
    install_wezterm
    install_aur_helper

    # Neovim nightly（neovim-nightly-bin from AUR）
    if command -v nvim &>/dev/null && nvim --version 2>/dev/null | head -1 | grep -q 'dev'; then
        echo "[SKIP] neovim (nightly) already installed"
    else
        echo "[INSTALL] neovim-nightly-bin (AUR)..."
        if command -v yay &>/dev/null; then
            yay -S --noconfirm neovim-nightly-bin
        elif command -v paru &>/dev/null; then
            paru -S --noconfirm neovim-nightly-bin
        else
            echo "[WARN] 需要 yay 或 paru 安装 AUR 包"
        fi
    fi
fi

# vim/vi/editor 统一指向 nvim（系统级：覆盖 sudo/脚本/git 等不走 shell 别名的场景）
if command -v nvim &>/dev/null; then
    NVIM_BIN="$(command -v nvim)"
    if command -v update-alternatives &>/dev/null; then
        # Debian/Ubuntu 系：alternatives 机制，优先级 100 > nano(40) > vim.tiny(15)
        for name in vim vi editor; do
            CURRENT="$(update-alternatives --query "$name" 2>/dev/null | awk '/^Value:/{print $2}')"
            if [[ "$CURRENT" == "$NVIM_BIN" ]]; then
                echo "[SKIP] alternatives: $name -> $NVIM_BIN"
            else
                echo "[OK] alternatives: $name -> $NVIM_BIN"
                sudo update-alternatives --install "/usr/bin/$name" "$name" "$NVIM_BIN" 100
            fi
        done
    else
        # 无 update-alternatives（如 Arch）：/usr/local/bin 符号链接兜底（PATH 优先于 /usr/bin）
        # editor 是 Debian 特有约定，此处只处理 vim/vi
        for name in vim vi; do
            if [[ "$(readlink -f "/usr/local/bin/$name" 2>/dev/null)" == "$(readlink -f "$NVIM_BIN")" ]]; then
                echo "[SKIP] symlink: /usr/local/bin/$name -> $NVIM_BIN"
            else
                echo "[OK] symlink: /usr/local/bin/$name -> $NVIM_BIN"
                sudo ln -sfn "$NVIM_BIN" "/usr/local/bin/$name"
            fi
        done
    fi
else
    echo "[WARN] 未检测到 nvim，跳过 vim/vi/editor 重定向"
fi

# Oh My Zsh
if [[ -d "$HOME/.oh-my-zsh" ]]; then
    echo "[SKIP] Oh My Zsh already installed"
else
    echo "[INSTALL] Oh My Zsh..."
    RUNZSH=no KEEP_ZSHRC=yes sh -c "$(curl -fsSL https://raw.github.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
fi

# Zsh 插件（oh-my-zsh custom plugins）
ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"
declare -A ZSH_PLUGINS=(
    [zsh-syntax-highlighting]="https://github.com/zsh-users/zsh-syntax-highlighting"
    [zsh-autosuggestions]="https://github.com/zsh-users/zsh-autosuggestions"
    [zsh-completions]="https://github.com/zsh-users/zsh-completions"
)

for plugin in "${!ZSH_PLUGINS[@]}"; do
    if [[ -d "$ZSH_CUSTOM/plugins/$plugin" ]]; then
        echo "[SKIP] $plugin already installed"
    else
        echo "[INSTALL] $plugin..."
        git clone "${ZSH_PLUGINS[$plugin]}" "$ZSH_CUSTOM/plugins/$plugin"
    fi
done

# chezmoi auto commit/push
mkdir -p ~/.config/chezmoi
if ! grep -q "autoCommit" ~/.config/chezmoi/chezmoi.toml 2>/dev/null; then
    cat >> ~/.config/chezmoi/chezmoi.toml << 'EOF'
[git]
    autoCommit = true
    autoPush = true
EOF
    echo "[OK] chezmoi auto commit/push enabled"
else
    echo "[SKIP] chezmoi already configured"
fi

echo "[DONE] Linux setup complete"
{{ end -}}
