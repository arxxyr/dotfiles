{{- if eq .chezmoi.os "windows" }}
param(
[Parameter(Position=0)]
[ValidateSet('start','kill')]
[string]$Action = 'start',

# 默认值取自 .chezmoidata.toml 的 [kimi]，与 config.toml 的 modify_ 强制项同源
[string]$Model = '{{ .kimi.model }}',
[string]$Effort = '{{ .kimi.effort }}',

[Parameter(ValueFromRemainingArguments=$true)]
[string[]]$Rest
)

$ErrorActionPreference = 'Stop'

switch ($Action) {
'kill' {
$procs = Get-Process -Name 'kimi' -ErrorAction SilentlyContinue
if (-not $procs) {
Write-Host "[OK] No kimi processes running"
return
}
Write-Host "Killing kimi processes:"
$procs | ForEach-Object { Write-Host " PID $($_.Id) - $($_.ProcessName)" }
$procs | Stop-Process -Force
Write-Host "[OK] Done"
}
'start' {
# 与 bash 版 cc-kimi 对齐：直连 api.kimi.com，不设代理、不改时区。
# 思考档走 forcedEffort 通道，优先级高于 config.toml 与模型 default_effort，且不写回配置文件。
$env:KIMI_MODEL_THINKING_EFFORT = $Effort

Write-Host "Model:  $Model"
Write-Host "Effort: $Effort (locked via KIMI_MODEL_THINKING_EFFORT)"
Write-Host "Mode:   auto (--auto = Never Ask：全程不打断，工具调用自动批准且不再反问)"

# 与 bash 版一致：先找官方安装器落点，再退回 PATH，PATH 里同名的旧版 Python kimi-cli 抢不到
$kimiExe = Join-Path $env:USERPROFILE '.kimi-code\bin\kimi.exe'
if (-not (Test-Path $kimiExe)) {
$kimiExe = (Get-Command 'kimi' -ErrorAction SilentlyContinue).Source
if (-not $kimiExe) { throw 'kimi not found. 先装 Kimi Code：irm https://code.kimi.com/kimi-code/install.ps1 | iex' }
}

$kimiArgs = @('--auto', '--model', $Model)
if ($Rest) { $kimiArgs += $Rest }
& $kimiExe @kimiArgs
}
}
{{ end -}}
