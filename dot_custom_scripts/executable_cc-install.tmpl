{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail

if [[ $# -eq 0 ]]; then
    echo "用法: cc-install <包名> [包名...]"
    exit 1
fi

PROXYCHAINS="${PROXYCHAINS_BIN:-proxychains}"
# /etc 配置里的代理地址在 WSL 随重启漂移，改挂 cc-pc 动态生成的配置
CONF="$("$HOME/.custom_scripts/cc-pc" --refresh)"

echo ">>> 安装: $*"
sudo "$PROXYCHAINS" -f "$CONF" apt install -y "$@"

echo "[OK] Done"
{{ else if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
set -euo pipefail

if [[ $# -eq 0 ]]; then
    echo "用法: cc-install <包名> [包名...]"
    exit 1
fi

# 默认代理主机统一走 cc-proxy-host（darwin 上等价于 127.0.0.1）；PROXY 可覆盖
PROXY="${PROXY:-http://$("$HOME/.custom_scripts/cc-proxy-host"):10808}"

export HTTP_PROXY="$PROXY"
export HTTPS_PROXY="$PROXY"
export ALL_PROXY="$PROXY"
export NO_PROXY="localhost,127.0.0.1,::1,.local"

echo ">>> 安装: $* (proxy: $PROXY)"
brew install "$@"

echo "[OK] Done"
{{ end -}}
