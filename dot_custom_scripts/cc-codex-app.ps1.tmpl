{{- if eq .chezmoi.os "windows" -}}
{{ printf "\ufeff" -}}
[CmdletBinding()]
param(
    [Parameter(Position = 0)]
    [ValidateSet('start', 'restart', 'kill')]
    [string]$Action = 'start',

    [Parameter(Position = 1)]
    [string]$Path = '.',

    [string]$AppPath = $env:CODEX_APP_PATH,
    [string]$Proxy = $(if ($env:CODEX_PROXY) { $env:CODEX_PROXY } else { 'http://{{ .proxy.host }}:{{ .proxy.port }}' })
)

$ErrorActionPreference = 'Stop'
Set-StrictMode -Version 2.0

function test_codex_desktop {
    param([string]$Executable)

    if (-not $Executable -or -not (Test-Path -LiteralPath $Executable -PathType Leaf)) { return $false }
    if ([IO.Path]::GetFileName($Executable) -notmatch '^(Codex|ChatGPT)\.exe$') { return $false }
    $archive = Join-Path (Split-Path -Parent $Executable) 'resources\app.asar'
    if (-not (Test-Path -LiteralPath $archive -PathType Leaf)) { return $false }

    # 读取 ASAR 中的 package.json 验证桌面身份，避免选中同名 CLI 或旧版原生 ChatGPT。
    $reader = $null
    try {
        $reader = New-Object IO.BinaryReader([IO.File]::OpenRead($archive))
        $null = $reader.ReadUInt32()
        $headerSize = $reader.ReadUInt32()
        $null = $reader.ReadUInt32()
        $jsonSize = $reader.ReadUInt32()
        if ($jsonSize -gt 32MB -or $headerSize -lt $jsonSize) { return $false }
        $header = [Text.Encoding]::UTF8.GetString($reader.ReadBytes($jsonSize)) | ConvertFrom-Json
        $entry = $header.files.'package.json'
        if ($entry.size -gt 1MB) { return $false }
        $null = $reader.BaseStream.Seek((8 + [long]$headerSize + [long]$entry.offset), 'Begin')
        $package = [Text.Encoding]::UTF8.GetString($reader.ReadBytes($entry.size)) | ConvertFrom-Json
        return $package.name -eq 'openai-codex-electron'
    } catch {
        return $false
    } finally {
        if ($reader) { $reader.Dispose() }
    }
}

function get_codex_app_paths {
    if ($AppPath) {
        $resolved = (Get-Item -LiteralPath $AppPath).FullName
        if (-not (test_codex_desktop $resolved)) { throw '-AppPath 必须指向 Codex 桌面版的 Codex.exe 或 ChatGPT.exe。' }
        return $resolved
    }

    $candidates = @()
    # 当前协议注册优先，跟随安装器选择的版本；绝不从 PATH 解析同名 CLI。
    foreach ($registryRoot in @('HKCU:', 'HKLM:')) {
        $key = Get-Item -LiteralPath "$registryRoot\Software\Classes\codex\shell\open\command" -ErrorAction SilentlyContinue
        if ($key) {
            $command = [Environment]::ExpandEnvironmentVariables([string]$key.GetValue(''))
            if ($command -match '^\s*"([^"]+\.exe)"' -or $command -match '^\s*(\S+\.exe)(?:\s|$)') {
                $candidates += $Matches[1]
            }
        }
    }

    # 商店安装目录包含版本号，必须查询当前用户包清单，不能硬编码 WindowsApps 路径。
    $findStoreApps = {
        Get-AppxPackage -ErrorAction Stop |
            Where-Object { $_.Name -match '^OpenAI\.(Codex|ChatGPT)' } |
            Sort-Object Version -Descending |
            ForEach-Object {
                $package = $_
                $manifest = Get-AppxPackageManifest -Package $package.PackageFullName -ErrorAction Stop
                foreach ($application in $manifest.Package.Applications.Application) {
                    $executable = $application.GetAttribute('Executable')
                    if ($executable) { Join-Path $package.InstallLocation $executable }
                }
            }
    }
    try {
        $candidates += @(& $findStoreApps)
    } catch {
        # 部分 PowerShell 7 环境不能直接加载 Appx，交给系统自带的 Windows PowerShell 查询。
        $windowsPowerShell = Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe'
        if ($PSVersionTable.PSEdition -eq 'Core' -and (Test-Path -LiteralPath $windowsPowerShell)) {
            $query = '$ErrorActionPreference = ''Stop''; @(& { ' + $findStoreApps.ToString() + ' }) | ConvertTo-Json -Compress'
            $encoded = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($query))
            try {
                $result = & $windowsPowerShell -NoProfile -NonInteractive -EncodedCommand $encoded 2>$null
                if ($LASTEXITCODE -eq 0 -and $result) { $candidates += @($result | ConvertFrom-Json) }
            } catch { Write-Verbose '商店安装目录查询失败，继续检查常规安装目录。' }
        }
    }

    foreach ($root in @($env:LOCALAPPDATA, $env:ProgramFiles, ${env:ProgramFiles(x86)})) {
        if (-not $root) { continue }
        foreach ($name in @('ChatGPT', 'Codex')) {
            $candidates += Join-Path $root "$name\$name.exe"
            $candidates += Join-Path $root "Programs\$name\$name.exe"
        }
    }
    $candidates | Select-Object -Unique | Where-Object { test_codex_desktop $_ }
}

function split_windows_command_line {
    param([string]$CommandLine)

    if (-not $CommandLine) { return @() }
    if (-not ('CodexDesktopLauncher.NativeMethods' -as [type])) {
        Add-Type -TypeDefinition @'
using System;
using System.Runtime.InteropServices;

namespace CodexDesktopLauncher
{
    public static class NativeMethods
    {
        [DllImport("shell32.dll", SetLastError = true, CharSet = CharSet.Unicode, ExactSpelling = true)]
        public static extern IntPtr CommandLineToArgvW(string commandLine, out int argumentCount);

        [DllImport("kernel32.dll", ExactSpelling = true)]
        public static extern IntPtr LocalFree(IntPtr memory);
    }
}
'@
    }

    $argumentCount = 0
    $argumentsPointer = [CodexDesktopLauncher.NativeMethods]::CommandLineToArgvW(
        $CommandLine,
        [ref]$argumentCount
    )
    if ($argumentsPointer -eq [IntPtr]::Zero) {
        throw [ComponentModel.Win32Exception]::new([Runtime.InteropServices.Marshal]::GetLastWin32Error())
    }

    try {
        $arguments = [Collections.Generic.List[string]]::new($argumentCount)
        for ($index = 0; $index -lt $argumentCount; $index++) {
            $argumentPointer = [Runtime.InteropServices.Marshal]::ReadIntPtr(
                $argumentsPointer,
                $index * [IntPtr]::Size
            )
            $arguments.Add([Runtime.InteropServices.Marshal]::PtrToStringUni($argumentPointer))
        }
        return $arguments.ToArray()
    } finally {
        $null = [CodexDesktopLauncher.NativeMethods]::LocalFree($argumentsPointer)
    }
}

function get_codex_desktop_processes {
    param([string[]]$AppPaths)

    Get-CimInstance Win32_Process -Filter "Name = 'Codex.exe' OR Name = 'ChatGPT.exe'" |
        Where-Object {
            if (-not $_.ExecutablePath -or -not $_.CommandLine -or
                $AppPaths -notcontains $_.ExecutablePath) {
                return $false
            }
            $hasProcessType = $false
            foreach ($argument in @(split_windows_command_line $_.CommandLine)) {
                $argument = $argument.Trim()
                if ($argument -eq '--' -or
                    $argument -cmatch '^(?:--|[-/])single-argument(?:=|$)') {
                    break
                }
                if ($argument -match '(?i)^(?:--|[-/])type(?:=|$)') {
                    $hasProcessType = $true
                    break
                }
            }
            return -not $hasProcessType
        }
}

function normalize_proxy_url {
    param([string]$Value)

    if (-not $Value -or $Value -cne $Value.Trim() -or $Value -match '[^\x00-\x7F]') {
        return $null
    }
    # 先按原始文本限定为纯 authority，避免不同 .NET 版本对空白和转义路径的 URI 归一化差异。
    $syntaxMatch = [regex]::Match(
        $Value,
        '(?i)^(?:https?|socks[45])://(?<authority>[^/?#\\\x00-\x20\x7F]+)/?$'
    )
    if (-not $syntaxMatch.Success) { return $null }
    $authorityText = $syntaxMatch.Groups['authority'].Value
    if ($authorityText.Contains('%')) { return $null }
    $validAuthority = if ($authorityText.StartsWith('[')) {
        $authorityText -match '^\[[^\[\]]+\](?::[0-9]+)?$'
    } else {
        $authorityText -match '^[^:]+(?::[0-9]+)?$'
    }
    if (-not $validAuthority) { return $null }

    $uri = $null
    if (-not [Uri]::TryCreate($Value, [UriKind]::Absolute, [ref]$uri) -or
        $uri.Scheme -notin @('http', 'https', 'socks4', 'socks5') -or
        -not $uri.Host -or $uri.UserInfo -or $uri.AbsolutePath -ne '/' -or
        $uri.Query -or $uri.Fragment -or $uri.IdnHost -match '%') {
        return $null
    }
    $hostName = $uri.IdnHost.ToLowerInvariant()
    if ($uri.HostNameType -eq [UriHostNameType]::IPv6) {
        # .NET Framework 会展开 IPv6，.NET 则通常保留压缩形式；统一后保证两种 PowerShell 行为一致。
        $hostName = "[$([Net.IPAddress]::Parse($hostName).ToString().ToLowerInvariant())]"
    }
    $authority = "$($uri.Scheme.ToLowerInvariant())://$hostName"
    if (-not $uri.IsDefaultPort) { $authority += ":$($uri.Port)" }
    return $authority
}

function test_codex_desktop_proxy {
    param([object]$Desktop, [string]$ProxyUrl, [string]$ProxyBypassList)

    if (-not $Desktop.CommandLine) { return $false }
    $proxyArguments = [Collections.Generic.List[string]]::new()
    $bypassArguments = [Collections.Generic.List[string]]::new()
    $proxyPattern = [regex]::new('(?i)^(?:--|[-/])proxy-server(?:=(?<url>.*))?$')
    $bypassPattern = [regex]::new('(?i)^(?:--|[-/])proxy-bypass-list(?:=(?<value>.*))?$')
    $conflictingProxyPattern = [regex]::new(
        '(?i)^(?:--|[-/])(?:no-proxy-server|proxy-auto-detect|proxy-pac-url)(?:=|$)'
    )
    foreach ($argument in @(split_windows_command_line $Desktop.CommandLine)) {
        $argument = $argument.Trim()
        if ($argument -eq '--' -or
            $argument -cmatch '^(?:--|[-/])single-argument(?:=|$)') {
            break
        }
        if ($conflictingProxyPattern.IsMatch($argument)) { return $false }
        $match = $proxyPattern.Match($argument)
        if ($match.Success) { $proxyArguments.Add($match.Groups['url'].Value) }
        $match = $bypassPattern.Match($argument)
        if ($match.Success) { $bypassArguments.Add($match.Groups['value'].Value) }
    }
    # 重复参数的优先级不直观；即使其中一个匹配，也通过冷重启收敛为唯一配置。
    if ($proxyArguments.Count -ne 1 -or $bypassArguments.Count -ne 1) { return $false }
    $normalizedProxy = normalize_proxy_url $proxyArguments[0]
    if (-not $normalizedProxy -or $normalizedProxy -ine $ProxyUrl) { return $false }
    return $bypassArguments[0] -ceq $ProxyBypassList
}

function stop_codex_desktop {
    param([object[]]$Processes)

    foreach ($desktop in $Processes) {
        $process = Get-Process -Id $desktop.ProcessId -ErrorAction SilentlyContinue
        if (-not $process) { continue }
        try {
            # 获取进程对象后再确认路径；只终止桌面主进程，不按名称杀 CLI 或整个进程树。
            if ($process.Path -ine $desktop.ExecutablePath -or $process.HasExited) { continue }
            Write-Host "正在退出桌面应用：PID=$($process.Id)"
            $null = $process.CloseMainWindow()
            if (-not $process.WaitForExit(5000)) {
                $process.Kill()
                if (-not $process.WaitForExit(5000)) { throw "桌面进程退出超时：PID=$($process.Id)" }
            }
        } finally {
            $process.Dispose()
        }
    }
}

function quote_windows_argument {
    param([string]$Value)

    # ProcessStartInfo.Arguments 在 .NET Framework 中需要按 Windows 命令行规则保留引号及尾部反斜杠。
    $quoted = [regex]::Replace($Value, '(\\*)"', '$1$1\"')
    $quoted = [regex]::Replace($quoted, '(\\+)$', '$1$1')
    return '"' + $quoted + '"'
}

function start_codex_desktop {
    param(
        [string]$Executable,
        [string]$Workspace,
        [string]$ProxyUrl,
        [string]$ProxyBypassList,
        [string]$TimeZone
    )

    $arguments = @(
        "--proxy-server=$ProxyUrl",
        "--proxy-bypass-list=$ProxyBypassList",
        '--open-project',
        $Workspace
    )
    $startInfo = New-Object Diagnostics.ProcessStartInfo
    $startInfo.FileName = $Executable
    $startInfo.UseShellExecute = $false
    $startInfo.WorkingDirectory = $Workspace
    $startInfo.Arguments = ($arguments | ForEach-Object { quote_windows_argument $_ }) -join ' '
    # 只修改子进程环境；Windows 环境变量不区分大小写，无需另设小写副本。
    foreach ($name in @('HTTP_PROXY', 'HTTPS_PROXY', 'ALL_PROXY')) {
        $startInfo.EnvironmentVariables[$name] = $ProxyUrl
    }
    $startInfo.EnvironmentVariables['NO_PROXY'] = 'localhost,127.0.0.1,::1,.local'
    $startInfo.EnvironmentVariables['TZ'] = $TimeZone
    $process = [Diagnostics.Process]::Start($startInfo)
    if ($process) { $process.Dispose() }
}

$appPaths = @(get_codex_app_paths)
if ($appPaths.Count -eq 0) {
    throw '未找到 Codex 桌面版。请安装桌面应用，或用 -AppPath 指定其 Codex.exe / ChatGPT.exe（不是 Codex CLI）。'
}
$running = @(get_codex_desktop_processes $appPaths)
if ($Action -eq 'kill') {
    stop_codex_desktop $running
    Write-Host '[OK] Codex 桌面应用已退出。'
    return
}

# 在退出旧进程前完成输入校验，避免错误路径或代理导致现有工作被中断。
$workspace = Get-Item -LiteralPath $Path
if ($workspace.PSProvider.Name -ne 'FileSystem' -or -not $workspace.PSIsContainer) {
    throw '工作区必须是存在的文件系统目录。'
}
$proxyUrl = normalize_proxy_url $Proxy
if (-not $proxyUrl) {
    throw '代理必须是无认证信息的 http/https/socks4/socks5 地址，主机名须为 ASCII/Punycode，例如 http://127.0.0.1:10808。'
}
$proxyBypassList = 'localhost;127.0.0.1;[::1];*.local'
$timeZone = if ($env:CODEX_TZ) { $env:CODEX_TZ } else { 'America/New_York' }

if ($Action -eq 'restart') {
    stop_codex_desktop $running
    $running = @()
} elseif ($running.Count -gt 0) {
    # Electron 单例不会把新启动参数写回已有主进程；代理配置不一致时必须冷重启。
    $proxyMismatches = @(
        $running | Where-Object {
            -not (test_codex_desktop_proxy $_ $proxyUrl $proxyBypassList)
        }
    )
    if ($proxyMismatches.Count -gt 0) {
        Write-Host "检测到正在运行的桌面应用未使用当前代理，正在冷重启：proxy=$proxyUrl"
        stop_codex_desktop $running
        $running = @()
    } else {
        Write-Verbose '桌面应用已使用当前代理，将复用现有进程并转交工作区；现有进程的时区不会改变。'
    }
}

$executable = $appPaths[0]
if ($Action -eq 'start' -and $running.Count -gt 0) { $executable = $running[0].ExecutablePath }
Write-Host "代理：$proxyUrl"
if ($running.Count -gt 0) {
    Write-Host '时区：沿用现有桌面进程（如需更改请执行 cc-codex-app restart）'
} else {
    Write-Host "时区：$timeZone"
}
Write-Host "工作区：$($workspace.FullName)"
start_codex_desktop $executable $workspace.FullName $proxyUrl $proxyBypassList $timeZone
{{- end -}}
