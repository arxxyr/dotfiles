{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail

FORCE_IPV4="${FORCE_IPV4:-1}"
PROXYCHAINS="${PROXYCHAINS_BIN:-proxychains}"
# /etc 配置里的代理地址在 WSL 随重启漂移，改挂 cc-pc 动态生成的配置
CONF="$("$HOME/.custom_scripts/cc-pc" --refresh)"

tmp_conf=""
cleanup() {
[[ -n "${tmp_conf:-}" && -f "$tmp_conf" ]] && sudo rm -f "$tmp_conf" || true
}
trap cleanup EXIT

if [[ "$FORCE_IPV4" == "1" ]]; then
tmp_conf="/etc/apt/apt.conf.d/99-force-ipv4-tmp-$(date +%s)"
echo 'Acquire::ForceIPv4 "true";' | sudo tee "$tmp_conf" >/dev/null
fi

echo "[1/3] Updating package index..."
sudo "$PROXYCHAINS" -f "$CONF" apt update

echo "[2/3] Upgrading packages..."
sudo "$PROXYCHAINS" -f "$CONF" apt full-upgrade -y

echo "[3/3] Cleaning up..."
sudo apt autoremove --purge -y

echo "[OK] Done"
{{ else if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
set -euo pipefail

# 默认代理主机统一走 cc-proxy-host（darwin 上等价于 127.0.0.1）；PROXY 可覆盖
PROXY="${PROXY:-http://$("$HOME/.custom_scripts/cc-proxy-host"):10808}"

export HTTP_PROXY="$PROXY"
export HTTPS_PROXY="$PROXY"
export ALL_PROXY="$PROXY"
export NO_PROXY="localhost,127.0.0.1,::1,.local"

echo "Proxy: $PROXY"

echo "[1/3] Updating Homebrew..."
brew update

echo "[2/3] Upgrading packages..."
brew upgrade

echo "[3/3] Cleaning up..."
brew cleanup

echo "[OK] Done"
{{ end -}}
