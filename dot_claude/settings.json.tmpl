{{- /* WSL：settings 的 env 优先级高于进程环境变量，写死 127.0.0.1 会盖掉
     cc-claude 动态注入的网关代理（NAT 下 127.0.0.1 是虚拟机自己），故裁掉，
     代理职责归 cc-claude；其余平台代理在本机，保持 127.0.0.1 */ -}}
{{- $wsl := and (eq .chezmoi.os "linux") (contains "microsoft" (lower .chezmoi.kernel.osrelease)) -}}
{
  "env": {
{{- if not $wsl }}
    "HTTP_PROXY": "http://{{ .proxy.host }}:{{ .proxy.port }}",
    "HTTPS_PROXY": "http://{{ .proxy.host }}:{{ .proxy.port }}",
{{- end }}
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [],
    "deny": []
  },
  "statusLine": {
    "type": "command",
    "command": "bash {{ .chezmoi.homeDir | replace "\\" "/" }}/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "huggingface-skills@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-daltonized",
  "teammateMode": "auto",
  "model": "claude-fable-5[1m]"
}
