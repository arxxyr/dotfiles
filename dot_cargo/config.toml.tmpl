{{- $wsl := and (eq .chezmoi.os "linux") (contains "microsoft" (lower .chezmoi.kernel.osrelease)) -}}
# [source.crates-io]
# replace-with = 'rsproxy-sparse'
# [source.rsproxy]
# registry = "https://rsproxy.cn/crates.io-index"
# [source.rsproxy-sparse]
# registry = "sparse+https://rsproxy.cn/index/"
# [registries.rsproxy]
# index = "https://rsproxy.cn/crates.io-index"

[net]
retry = 10
git-fetch-with-cli = true

[http]
timeout = 600
multiplexing = false

{{ if $wsl -}}
# WSL：127.0.0.1 是虚拟机自己，且 NAT 网关 IP 随重启漂移，不能写死；
# 代理交给环境变量（cc-proxy 会按当前网关动态设置）
{{- else -}}
# 如果你走代理（按你的实际改）
# socks5h 会让 DNS 也走代理，通常更稳
proxy = "socks5h://{{ .proxy.host }}:{{ .proxy.port }}"
# 或 http 代理
#proxy = "http://{{ .proxy.host }}:{{ .proxy.port }}"
{{- end }}

# 如果你的 cargo 支持这俩字段（新版本一般支持）
low-speed-limit = 1
# low-speed-time = 600
