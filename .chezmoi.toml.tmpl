# chezmoi 自身的配置。它拒绝被当普通文件纳管
#   （chezmoi add 会报 "cannot add chezmoi's config file to chezmoi"），
# 官方机制就是源仓库根目录这份模板：chezmoi init 时据此生成
# ~/.config/chezmoi/chezmoi.toml。
#
# 注意与其他纳管文件的区别：这份不由 chezmoi apply 收敛，改完要跑 chezmoi init
# 重新生成；apply 只会在检测到模板比配置新时给出提示。

[git]
    # 两者刻意关闭：开着时 chezmoi forget / add 这类改动源仓库的命令会立刻自动
    # 提交并推送，还会把工作区里当时未提交的改动一并卷进去，生成
    # "Add X Remove X Remove Y" 这种不符合 Conventional Commits 规范的消息。
    # 改为手动：改源文件 → chezmoi diff → chezmoi apply → git add/commit/push。
    autoCommit = false
    autoPush = false
{{- if eq .chezmoi.os "windows" }}

# Windows 没有 shebang 机制：chezmoi 把 modify_ 脚本落成临时文件后直接 CreateProcess，
# 必然报 "%1 is not a valid Win32 application"，只能靠 interpreters 按扩展名分发解释器。
#
# 为此四个 modify_ 脚本统一带 .py 后缀（modify_settings.json.py.tmpl 等）。chezmoi 对
# modify_ 会把目标名末尾命中 interpreters 的扩展名当成「脚本扩展名」剥掉（sourcestate.go，
# 全平台同一逻辑）：剥掉的是 .py，目标名仍是 settings.json / config.toml / .skill-lock.json。
# 反例：曾直接给 json/toml 配 interpreters，结果剥掉的是 .json/.toml，Windows 上产物全写进
# .claude/settings、.codex/config 这类无扩展名文件，真正的配置两周没收敛。
#
# py 本就在 chezmoi 默认 interpreters 表里（全平台），但默认命令是 python3，Windows 上会命中
# WindowsApps 里的应用商店占位程序，故这里改钉 py（Python Launcher，随 python.org 安装进
# C:\Windows）：它会按脚本首行 #!/usr/bin/env python3 挑版本。init 时探测不到就留字面量
# "py"，交由 apply 时的 PATH 解析。Unix 用默认的 python3（与 shebang 找到的是同一个），不设这段。
{{- $py := or (lookPath "py") (lookPath "python") "py" }}
[interpreters.py]
    command = {{ $py | quote }}
{{- end }}
