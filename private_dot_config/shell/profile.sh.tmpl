# ~/.config/shell/profile.sh — 共享环境变量，登录时加载一次
# 由 .profile (bash) 和 .zprofile (zsh) source

{{- if eq .chezmoi.os "darwin" }}

# Homebrew
eval "$(/opt/homebrew/bin/brew shellenv 2>/dev/null)" || eval "$(/usr/local/bin/brew shellenv 2>/dev/null)"
{{- end }}

# rust/cargo
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# ruby/rbenv
export PATH="$HOME/.rbenv/bin:$PATH"

# rvm
export PATH="$HOME/.rvm/bin:$PATH"

# local bin
export PATH="$HOME/.local/bin:$PATH"

# NVM 目录（函数加载在 rc 文件中）
export NVM_DIR="$HOME/.nvm"

{{- if ne .chezmoi.os "darwin" }}

# goproxy
export GOPROXY=https://proxy.golang.com.cn,direct
{{- end }}

{{- if eq .chezmoi.os "linux" }}

# CUDA
export PATH="/usr/local/cuda/bin:$PATH"

# rviz2 QT 缩放
export QT_AUTO_SCREEN_SCALE_FACTOR=0
{{- end }}

# zig
export PATH="$HOME/env/zig:$PATH"

# xmake
[ -s "$HOME/.xmake/profile" ] && . "$HOME/.xmake/profile"

# uv
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

# kimi-code（Kimi Code CLI；安装脚本默认把 export 直写 ~/.zshrc，那是纳管文件、apply 会覆盖，统一收口到这里）
# 追加到末尾而非前置：该目录还捆了一份 fd，前置会遮蔽 brew/apt 装的系统 fd；kimi 无重名，放末尾照样命中
case ":$PATH:" in
    *":$HOME/.kimi-code/bin:"*) ;;
    *) export PATH="$PATH:$HOME/.kimi-code/bin" ;;
esac

# 自定义脚本目录
case ":$PATH:" in
    *":$HOME/.custom_scripts:"*) ;;
    *) export PATH="$HOME/.custom_scripts:$PATH" ;;
esac

# proxychains 自动配置：每次登录经 cc-pc --refresh 按当前环境重新生成
# （WSL 网关随重启漂移，mac/裸机固定 127.0.0.1）。proxychains-ng 读
# PROXYCHAINS_CONF_FILE 优先于 /etc，裸敲 proxychains4 <cmd> 即走动态配置；
# sudo 会剥离环境变量，root 场景用 cc-install / cc-pc（内部显式 -f）
if [ -x "$HOME/.custom_scripts/cc-pc" ]; then
    PROXYCHAINS_CONF_FILE="$("$HOME/.custom_scripts/cc-pc" --refresh 2>/dev/null)"
    if [ -n "$PROXYCHAINS_CONF_FILE" ]; then
        export PROXYCHAINS_CONF_FILE
    else
        unset PROXYCHAINS_CONF_FILE
    fi
fi

{{- if eq .chezmoi.os "darwin" }}

# node@24
export PATH="/opt/homebrew/opt/node@24/bin:$PATH"
{{- end }}

# 默认编辑器（nvim 可用时优先，git/crontab 等依赖 EDITOR）
if command -v nvim >/dev/null 2>&1; then
    export EDITOR=nvim
    export VISUAL=nvim
fi

# core dump
ulimit -c unlimited

export SHELL_PROFILE_LOADED=1
